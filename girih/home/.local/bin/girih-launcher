#!/usr/bin/env bash
# Girih launcher: a floating foot window running fzf over desktop entries.
# Hyprland gives it the chamfer and gradient frame (see hypr/girih.lua); foot
# requests the blur through ext-background-effect.
# Pressing the bind again while it is open closes it.
set -euo pipefail

if hyprctl clients -j | grep -q '"class": "girih-launcher"'; then
    hyprctl eval 'girih_close_launcher()' >/dev/null
    exit 0
fi

exec foot \
    --app-id=girih-launcher \
    --title=Launcher \
    -o main.pad=18x14 \
    -o main.font="JetBrainsMono Nerd Font:size=11" \
    -o main.line-height=22 \
    -o colors-dark.alpha=0.82 \
    -o colors-dark.blur=yes \
    "$HOME/.local/bin/girih-launcher-menu"
